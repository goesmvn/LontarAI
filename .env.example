# AI provider (server only). AI_PROVIDER = anthropic (default) | opencode | openai
#   anthropic -> ANTHROPIC_API_KEY (api.anthropic.com)
#   opencode  -> OPENCODE_API_KEY  (OpenCode Console, Claude models via https://opencode.ai/inference/anthropic).
#                Model gratis OpenCode hanya untuk aplikasi OpenCode; dari sini perlu kredit berbayar / paket Go.
#   openai    -> OPENAI_API_KEY    (hanya analisis; pembacaan karakter butuh anthropic/opencode)
AI_PROVIDER=opencode
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/inference/anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model (default claude-opus-5-5 untuk anthropic/opencode, gpt-4o untuk openai)
LONTAR_AI_MODEL=

# Supabase (Auth, Postgres, Storage). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin panel (server only). Comma-separated emails allowed into /admin.
# The service role key bypasses RLS; never expose it to the browser.
ADMIN_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server only). Default: Claude (claude-opus-5-5). Override model with LONTAR_AI_MODEL.
ANTHROPIC_API_KEY=
# Optional alternative provider: set AI_PROVIDER=openai and OPENAI_API_KEY (default model then gpt-4o).
AI_PROVIDER=anthropic
OPENAI_API_KEY=
LONTAR_AI_MODEL=

# Supabase (Auth, Postgres, Storage). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin panel (server only). Comma-separated emails allowed into /admin.
# The service role key bypasses RLS; never expose it to the browser.
ADMIN_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server only). Default model: gpt-4o; override with LONTAR_AI_MODEL.
OPENAI_API_KEY=
LONTAR_AI_MODEL=gpt-4o

# Supabase (Auth, Postgres, Storage). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin panel (server only). Comma-separated emails allowed into /admin.
# The service role key bypasses RLS; never expose it to the browser.
ADMIN_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=
